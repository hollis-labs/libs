#!/usr/bin/env bash
# Import an existing repository into a module subdirectory, keeping its history.
#
# Usage: scripts/import-repo [options] <source> <group>/<module>[/<subdir>]
#
#   <source>                 path or URL of the repository; its default branch is imported
#   <group>/<module>/<subdir>  where the files land, relative to the repository root.
#                            <group> is one of the groups in scripts/repo.conf (core,
#                            security, mcp, ...); <group>/<module> must already be a module
#                            (a directory holding a go.mod); <subdir> is a package path in it.
#   <group>/<module>         with --module-root: the module itself. It may not exist yet; the
#                            import then creates it. The group directory carries no go.mod.
#
# Options:
#   --target DIR        repository to import into (default: the repository this script is in)
#   --name NAME         name recorded in the commit message (default: source basename)
#   --keep-gomod        keep the imported go.mod and go.sum (default: remove them, see below)
#   --path-rename O:N   rename a path inside the SOURCE before it is moved under <dest>.
#                       Repeatable, applied in order. `--path-rename paths/:` lifts the
#                       contents of paths/ to the top of <dest>.
#   --module-root       <dest> is <group>/<module> itself: the source's files become the
#                       module's own files (a source whose repo root is the package root of
#                       the module). If the module already exists, its go.mod, doc.go and
#                       CHANGELOG.md may be replaced by the source's in the merge commit;
#                       any other file that exists on both sides aborts the import. The
#                       imported go.mod is kept, with its module line rewritten to
#                       <MODULE_PREFIX>/<group>/<module>, and so is every occurrence of the
#                       old module path in the module's .go and .md files.
#   --import-map O=N    also rewrite the module path prefix O to N in the imported .go files
#                       (the other standalone libraries the source imports, now at their
#                       group paths). Repeatable. Requirements in go.mod stay as they were.
#   --skip-source-scan  do not scan the source first (see below); the owner's decision only
#   --source-allowlist F  allowlist file for the source scan (RULE-ID PATH-GLOB REASON lines;
#                       paths are the source's own, not the destination's)
#   --allow-main        allow the import while main is checked out
#   -h, --help
#
# What it does: clones the source into a scratch directory, scans that clone with
# scripts/scan-public (tip AND full history; findings stop the import), rewrites it with
# git filter-repo so every path sits under <dest> (original commits, authors
# and dates are kept; abbreviated hashes in messages are rewritten), then merges it into
# the target with a merge commit that records the source name, its HEAD and its tags.
# The source repository is only read. The target must be clean.
#
# Old tags are not carried. A bare v1.2.3 tag means nothing in a repository whose
# modules are tagged <group>/<module>/vX.Y.Z, the commits it pointed at declare the old
# module path, and a tag push is an owner decision. The tags the source had are listed in
# the merge commit message with the tag name each would have here (tag prefix mapping).
#
# The imported go.mod and go.sum are removed in a follow-up commit (history keeps them)
# because a go.mod inside a module carves the subtree out of it. Merge the old
# requirements into <group>/<module>/go.mod afterwards, for example with go mod tidy.
#
# Work on a branch, not main: run this in a worktree and open a pull request.
# Needs git-filter-repo: set GIT_FILTER_REPO to the executable, or put it on PATH
# (python3 -m venv V && V/bin/pip install git-filter-repo).
set -euo pipefail
# shellcheck source-path=SCRIPTDIR
# shellcheck source=_common.sh
. "$(cd "$(dirname "$0")" && pwd)/_common.sh"

usage() {
  awk 'NR > 1 && /^set -euo pipefail/ { exit } NR > 1 { sub(/^# ?/, ""); print }' "$0"
}

target="$REPO_ROOT"
name=""
keep_gomod=0
allow_main=0
module_root=0
skip_scan=0
source_allowlist=""
renames=()
imports=()
while [ $# -gt 0 ]; do
  case "$1" in
    --target) [ $# -ge 2 ] || die "--target needs a directory"; target="$2"; shift 2 ;;
    --name) [ $# -ge 2 ] || die "--name needs a value"; name="$2"; shift 2 ;;
    --keep-gomod) keep_gomod=1; shift ;;
    --path-rename) [ $# -ge 2 ] || die "--path-rename needs OLD:NEW"; renames+=("$2"); shift 2 ;;
    --module-root) module_root=1; shift ;;
    --import-map) [ $# -ge 2 ] || die "--import-map needs OLD=NEW"; imports+=("$2"); shift 2 ;;
    --skip-source-scan) skip_scan=1; shift ;;
    --source-allowlist) [ $# -ge 2 ] || die "--source-allowlist needs a file"; source_allowlist="$2"; shift 2 ;;
    --allow-main) allow_main=1; shift ;;
    -h|--help) usage; exit 0 ;;
    --) shift; break ;;
    -*) die "unknown flag: $1 (see --help)" ;;
    *) break ;;
  esac
done
[ $# -eq 2 ] || { usage >&2; exit 2; }
source_repo="$1"
dest="${2%/}"

# --- validate the destination and the target repository -------------------------------
case "$dest" in
  /* | "") die "destination must be a relative path like <group>/<module>, got '$2'" ;;
esac
if printf '%s\n' "$dest" | grep -Eq '(^|/)\.\.?(/|$)|//'; then
  die "destination must not contain '.', '..' or empty elements: '$dest'"
fi
group="${dest%%/*}"
is_group "$group" || die "'$group' is not a group (groups: $(groups | tr '\n' ' ')); destination is <group>/<module>[/<subdir>]"
case "$dest" in
  */*) ;;
  *) die "destination must be <group>/<module>[/<subdir>]; '$dest' names only a group, and a group directory carries no go.mod" ;;
esac
modname="${dest#*/}"
modname="${modname%%/*}"
printf '%s\n' "$modname" | grep -Eq '^[a-z0-9][a-z0-9-]*$' || die "module name '$modname' must match [a-z0-9][a-z0-9-]* (lower case, digits, hyphens)"
module="$group/$modname"
if [ "$module_root" -eq 1 ]; then
  [ "$dest" = "$module" ] || die "--module-root takes just <group>/<module>, not '$dest'"
else
  [ "$dest" != "$module" ] || die "destination must be <group>/<module>/<subdir>; '$dest' names a module but no subdirectory (use --module-root to import into the module itself)"
fi

target="$(git -C "$target" rev-parse --show-toplevel 2>/dev/null)" || die "--target is not a git repository"
if [ "$module_root" -eq 1 ]; then
  if [ -e "$target/$group/$modname" ] && [ ! -f "$target/$module/go.mod" ]; then
    die "$module exists in the target but has no go.mod; it is not a module"
  fi
else
  [ -f "$target/$module/go.mod" ] || die "'$module' is not a module in $target (no $module/go.mod); import it first with --module-root"
  [ ! -e "$target/$dest" ] || die "$dest already exists in the target"
fi
[ ! -f "$target/$group/go.mod" ] || die "$group/go.mod exists in the target; a group directory carries no go.mod"
git -C "$target" rev-parse -q --verify HEAD >/dev/null || die "the target has no commits yet"
[ -z "$(git -C "$target" status --porcelain)" ] || die "the target working tree is not clean; commit or stash first"

branch="$(git -C "$target" symbolic-ref --short -q HEAD || true)"
if [ "$allow_main" -eq 0 ] && { [ "$branch" = "main" ] || [ "$branch" = "master" ]; }; then
  die "refusing to import onto $branch; use a task branch or worktree (or pass --allow-main)"
fi

if [ -z "$name" ]; then
  name="$(basename "$source_repo")"
  name="${name%.git}"
fi
printf '%s\n' "$name" | grep -Eq '^[A-Za-z0-9._-]+$' || die "name '$name' must match [A-Za-z0-9._-]+ (use --name)"

# --- find git-filter-repo --------------------------------------------------------------
if [ -n "${GIT_FILTER_REPO:-}" ]; then
  [ -x "$GIT_FILTER_REPO" ] || die "GIT_FILTER_REPO='$GIT_FILTER_REPO' is not an executable file"
  filter_repo="$GIT_FILTER_REPO"
else
  filter_repo="$(command -v git-filter-repo || true)"
  [ -n "$filter_repo" ] || die "git-filter-repo not found: set GIT_FILTER_REPO or put it on PATH (pip install git-filter-repo in a venv)"
fi

# --- work in a scratch directory --------------------------------------------------------
work="$(mktemp -d "${TMPDIR:-/tmp}/import-repo.XXXXXX")"
tmpref="refs/import-tmp/$name"
cleanup() {
  git -C "$target" update-ref -d "$tmpref" >/dev/null 2>&1 || true
  # Only ever remove the scratch directory this script made, and only if it still looks like it.
  case "${work:-}" in
    */import-repo.??????) [ ! -d "$work" ] || rm -rf -- "$work" ;;
  esac
}
trap cleanup EXIT

echo "cloning $name"
git clone --quiet --no-hardlinks "$source_repo" "$work/src" || die "could not clone '$source_repo'"
if [ "$skip_scan" -eq 0 ]; then
  echo "scanning $name (tip and full history) for secrets, internal hosts and private paths"
  scan_args=(--repo "$work/src")
  if [ -n "$source_allowlist" ]; then
    [ -f "$source_allowlist" ] || die "--source-allowlist '$source_allowlist' is not a file"
    scan_args+=(--allowlist "$source_allowlist")
  else
    scan_args+=(--no-allowlist)
  fi
  "$SCRIPT_DIR/scan-public" "${scan_args[@]}" >"$work/scan.log" 2>&1 || {
    cat "$work/scan.log" >&2
    die "source scan failed; fix the source, or have the owner triage and pass --source-allowlist (reasons required) or --skip-source-scan"
  }
fi
src_head="$(git -C "$work/src" rev-parse HEAD)"
src_commits="$(git -C "$work/src" rev-list --count HEAD)"
src_tags="$(git -C "$work/src" tag --merged HEAD | sort -V | tr '\n' ' ' | sed 's/ $//')"
# Tag prefix mapping: the tag each old tag would have here. Informational only; see above.
tag_map=""
for t in $src_tags; do
  case "$t" in
    v[0-9]*) tag_map="$tag_map$t -> $module/$t, " ;;
    *) tag_map="$tag_map$t -> (no mapping), " ;;
  esac
done
tag_map="${tag_map%, }"

echo "rewriting $src_commits commits under $dest/"
filter_args=(--force)
for r in ${renames[@]+"${renames[@]}"}; do
  filter_args+=(--path-rename "$r")
done
filter_args+=(--to-subdirectory-filter "$dest")
(cd "$work/src" && "$filter_repo" "${filter_args[@]}") >"$work/filter.log" 2>&1 || {
  cat "$work/filter.log" >&2
  die "git filter-repo failed"
}

echo "merging into $target"
git -C "$target" fetch --quiet --no-tags "$work/src" "HEAD:$tmpref"

msg="import: $name into $dest (history preserved)

Source: $name
Source HEAD: ${src_head:0:12} ($src_commits commits)
Source tags, not carried: ${src_tags:-none}
Tag prefix mapping (would be, if the owner ever re-tags): ${tag_map:-none}
Imported with scripts/import-repo (git filter-repo ${renames[*]+--path-rename ${renames[*]} }--to-subdirectory-filter $dest)."

if [ "$module_root" -eq 0 ]; then
  if ! git -C "$target" merge --quiet --no-ff --allow-unrelated-histories -m "$msg" "$tmpref"; then
    git -C "$target" merge --abort >/dev/null 2>&1 || true
    die "merge failed and was aborted; the target is unchanged"
  fi
else
  # The source becomes the module's own files, so it meets the skeleton's. Those three skeleton
  # files may be replaced by the source's; anything else that exists on both sides is a real conflict.
  git -C "$target" merge --quiet --no-ff --no-commit --allow-unrelated-histories "$tmpref" >/dev/null 2>&1 || true
  unmerged="$(git -C "$target" diff --name-only --diff-filter=U)"
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    case "$f" in
      "$module/go.mod" | "$module/doc.go" | "$module/CHANGELOG.md")
        git -C "$target" checkout --theirs -- "$f"
        git -C "$target" add -- "$f"
        ;;
      *)
        git -C "$target" merge --abort >/dev/null 2>&1 || true
        die "$f exists in the skeleton and in $name; aborted, the target is unchanged"
        ;;
    esac
  done <<EOF
$unmerged
EOF
  if [ -n "$(git -C "$target" diff --name-only --diff-filter=U)" ]; then
    git -C "$target" merge --abort >/dev/null 2>&1 || true
    die "unresolved conflicts; aborted, the target is unchanged"
  fi
  git -C "$target" commit --quiet -m "$msg" || { git -C "$target" merge --abort >/dev/null 2>&1 || true; die "commit failed; aborted"; }
fi

# rewrite_prefix OLD NEW DIR PATTERN...: replace the module path OLD by NEW in the tracked files of
# DIR matching a pattern, wherever OLD stands as a whole path prefix; stage the changes.
rewrite_prefix() {
  local old="$1" newp="$2" dir="$3" esc f pat
  shift 3
  esc="$(re_escape "$old")"
  for pat in "$@"; do
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      sed -E -i "s#${esc}([^A-Za-z0-9._-]|\$)#${newp}\\1#g" "$target/$f"
      git -C "$target" add -- "$f"
    done <<EOF
$(git -C "$target" ls-files -- "$dir/$pat")
EOF
  done
}

requirements=""
if [ "$module_root" -eq 1 ]; then
  requirements="$(awk '
    $1 == "require" && $2 == "(" { inblock = 1; next }
    inblock && $1 == ")" { inblock = 0; next }
    inblock { print $1, $2; next }
    $1 == "require" { print $2, $3 }
  ' "$target/$module/go.mod")"
  old_module="$(awk '$1 == "module" { print $2; exit }' "$target/$module/go.mod")"
  new_module="$MODULE_PREFIX/$module"
  if [ "$old_module" != "$new_module" ]; then
    # The module line changes; so does every other mention of the old module path in the
    # module's Go sources and Markdown (the module's packages import each other by it).
    awk -v new="$new_module" '$1 == "module" && !done { print "module " new; done = 1; next } { print }' \
      "$target/$module/go.mod" > "$work/go.mod.new"
    cp "$work/go.mod.new" "$target/$module/go.mod"
    git -C "$target" add -- "$module/go.mod"
    rewrite_prefix "$old_module" "$new_module" "$module" '*.go' '*.md'
    git -C "$target" commit --quiet -m "import: module path of $name is now $new_module

The imported go.mod is kept as the module's go.mod. Its module line changes, and so does the
old module path in the module's .go and .md files (was $old_module). Requirements are
untouched.

Requirements carried over:
${requirements:-  (none)}"
  fi
elif [ "$keep_gomod" -eq 0 ] && [ -f "$target/$dest/go.mod" ]; then
  # Record what the old go.mod required: go mod tidy alone resolves the latest versions,
  # not the ones the source was tested with.
  requirements="$(awk '
    $1 == "require" && $2 == "(" { inblock = 1; next }
    inblock && $1 == ")" { inblock = 0; next }
    inblock { print $1, $2; next }
    $1 == "require" { print $2, $3 }
  ' "$target/$dest/go.mod")"
  git -C "$target" rm --quiet -f "$dest/go.mod"
  [ ! -f "$target/$dest/go.sum" ] || git -C "$target" rm --quiet -f "$dest/go.sum"
  git -C "$target" commit --quiet -m "import: drop $name's go.mod and go.sum

$dest is now part of the $module module. Its requirements must be merged into
$module/go.mod at these versions (go mod tidy alone picks the latest); history
keeps the old files.

Requirements of the dropped go.mod:
${requirements:-  (none)}"
fi

for m in ${imports[@]+"${imports[@]}"}; do
  case "$m" in *=*) ;; *) die "--import-map wants OLD=NEW, got '$m'" ;; esac
  rewrite_prefix "${m%%=*}" "${m#*=}" "$dest" '*.go'
done
if [ -n "$(git -C "$target" diff --cached --name-only)" ]; then
  git -C "$target" commit --quiet -m "import: point $name's imports at their paths in this repository

Rewritten (old=new): ${imports[*]}"
fi

echo
echo "imported $name into $dest: $src_commits source commits preserved"
echo "HEAD $(git -C "$target" rev-parse --short HEAD)  ($(git -C "$target" log -1 --format=%s))"
nested="$(git -C "$target" ls-files "$dest" | grep '/go\.mod$' | grep -v '/testdata/' | grep -vx "$module/go\.mod" || true)"
if [ -n "$nested" ]; then
  echo "warning: nested go.mod left under $dest (scripts/check-layout will fail):" >&2
  while IFS= read -r n; do
    echo "  $n" >&2
  done <<EOF
$nested
EOF
fi
if [ -n "$requirements" ] && [ "$module_root" -eq 1 ]; then
  echo "requirements now in $module/go.mod, as the source had them:"
  while IFS= read -r r; do
    echo "  $r"
  done <<EOF
$requirements
EOF
elif [ -n "$requirements" ]; then
  echo "requirements of the dropped go.mod (carry these versions into $module/go.mod; go mod tidy alone picks the latest):"
  while IFS= read -r r; do
    echo "  $r"
  done <<EOF
$requirements
EOF
fi
others="$(printf '%s\n' "$requirements" | grep -E "^github\.com/hollis-labs/" | grep -vE "^$(re_escape "$MODULE_PREFIX")/" || true)"
if [ -n "$others" ]; then
  echo "warning: requirements on other Hollis Labs modules; their paths here are <group>/<module> (use --import-map for the imports, then fix go.mod):" >&2
  while IFS= read -r o; do
    echo "  $o" >&2
  done <<EOF
$others
EOF
fi
echo "next: merge requirements into $module/go.mod, fix import paths, run scripts/check $module and scripts/check-layout"
