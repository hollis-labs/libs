{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hollis-labs/libs/agent/resultenv/schema/resultenv.schema.json",
  "title": "Tool result envelope v1",
  "type": "object",
  "required": ["version", "outcome"],
  "properties": {
    "version": {"const": "resultenv/v1"},
    "outcome": {"enum": ["success", "nonzero_exit", "tool_error", "transport_error", "timeout", "cancelled", "unknown", "not_run"]},
    "mcp_result": {"type": "object", "description": "Raw MCP CallToolResult, including all content and metadata fields; unknown fields are preserved."},
    "output_schema_ref": {"type": "string", "minLength": 1},
    "truncation": {
      "type": "object",
      "required": ["truncated"],
      "properties": {"truncated": {"type": "boolean"}, "cursor": {"type": "string"}},
      "additionalProperties": false
    },
    "exit_code": {"type": "integer"},
    "stdout": {"type": "string"},
    "stderr": {"type": "string"},
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {"code": {"type": "string", "minLength": 1}, "message": {"type": "string"}},
      "additionalProperties": false
    },
    "redact": {"type": "array", "items": {"type": "string", "pattern": "^/"}, "uniqueItems": true}
  },
  "additionalProperties": false,
  "allOf": [
    {"if": {"properties": {"outcome": {"enum": ["success", "tool_error"]}}}, "then": {"required": ["mcp_result"]}},
    {"if": {"properties": {"outcome": {"const": "nonzero_exit"}}}, "then": {"required": ["exit_code"]}}
  ]
}
