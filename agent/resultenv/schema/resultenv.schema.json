{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hollis-labs/libs/agent/resultenv/schema/resultenv.schema.json",
  "title": "Tool result envelope v1",
  "type": "object",
  "required": ["version", "outcome"],
  "properties": {
    "version": {"const": "resultenv/v1"},
    "outcome": {"enum": ["success", "nonzero_exit", "signal", "tool_error", "transport_error", "timeout", "cancelled", "unknown", "not_run"]},
    "mcp_result": {"type": "object", "description": "Raw MCP CallToolResult, including all content and metadata fields; unknown fields are preserved."},
    "output_schema_ref": {"type": "string", "minLength": 1},
    "truncation": {
      "type": "object",
      "required": ["truncated"],
      "properties": {"truncated": {"type": "boolean"}, "cursor": {"type": "string"}},
      "additionalProperties": false
    },
    "exit_code": {"type": "integer"},
    "signal": {"type": "string", "minLength": 1},
    "cancel_requested": {"type": "boolean"},
    "cancel_confirmed": {"type": "boolean"},
    "stdout": {"type": "string"},
    "stderr": {"type": "string"},
    "combined_output": {"type": "string", "description": "PTY's one merged byte stream; do not label it stdout or stderr."},
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {"code": {"type": "string", "minLength": 1}, "message": {"type": "string"}},
      "additionalProperties": false
    },
    "redact": {"type": "array", "items": {"type": "string", "pattern": "^/"}, "uniqueItems": true}
  },
  "additionalProperties": false,
  "allOf": [
    {"if": {"properties": {"outcome": {"const": "success"}}}, "then": {"anyOf": [{"required": ["mcp_result"]}, {"required": ["exit_code"], "properties": {"exit_code": {"const": 0}}}]}},
    {"if": {"properties": {"outcome": {"const": "tool_error"}}}, "then": {"anyOf": [{"required": ["mcp_result"]}, {"required": ["error"]}]}},
    {"if": {"properties": {"outcome": {"const": "nonzero_exit"}}}, "then": {"required": ["exit_code"], "properties": {"exit_code": {"not": {"const": 0}}}}},
    {"if": {"properties": {"outcome": {"const": "signal"}}}, "then": {"required": ["signal"]}}
  ]
}
