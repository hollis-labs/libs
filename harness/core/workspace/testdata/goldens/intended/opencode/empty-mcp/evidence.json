      "cwd": "/fixture/project",
      "posture": {
        "provider": "opencode",
        "mapper": "adapters/registry.Descriptor.PostureFor",
        "posture": ""
      }
    },
    "resume_placement": "same table deltas apply to first and resumed launch; caller composes protocol tokens",
