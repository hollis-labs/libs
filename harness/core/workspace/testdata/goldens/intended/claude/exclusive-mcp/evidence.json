{
  "writer": "workspace/render",
  "source": "authored plan-field table and resolved fixture inputs",
  "bindings": {
    "compared": [
      "table argv tokens",
      "environment roots",
      "cwd",
      "RPC project parameters",
      "before-resume placement"
    ],
    "excluded": {
      "executable and protocol/turn argv": "runtime projection",
      "manifest, generation and reconcile report": "materialize",
      "permission flags and environment": "registry posture mapper"
    },
    "table": {
      "argv": [
        "--add-dir",
        "/fixture/project",
        "--mcp-config",
        "<boot>/.mcp.json",
        "--strict-mcp-config"
      ],
      "cwd": "<boot>",
      "posture": {
        "Provider": "claude",
        "Mapper": "adapters/registry.Descriptor.PostureFor",
        "Posture": ""
      }
    },
    "resume_placement": "same table deltas apply to first and resumed launch; caller composes protocol tokens",
    "case_family": "native files and table bindings",
    "root": "boot"
  },
