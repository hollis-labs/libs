{
  "writer": "providerplant",
  "source": "substrate legacy provider projection",
  "bindings": {
    "Bindings": {
      "argv": [
        "opencode",
        "run",
        "--format",
        "json",
        "--agent",
        "fixture",
        "--dir",
        "/fixture/project",
        "--",
        "Fixture kickoff.\n"
      ],
      "launch": {
        "convention": {
          "executable": "opencode",
          "mode": "subprocess-per-turn",
          "cwd": "project",
          "config_root": "boot",
          "argv": [
            {
              "kind": "literal",
              "value": "run"
            },
            {
              "kind": "literal",
              "value": "--format"
            },
            {
              "kind": "literal",
              "value": "json"
            },
            {
              "kind": "literal",
              "value": "--agent"
            },
            {
              "kind": "literal",
              "value": "fixture"
            },
            {
              "kind": "root",
              "value": "--dir",
              "root": "project",
              "omit_empty": true
            },
            {
              "kind": "resume",
              "value": "--session"
            },
            {
              "kind": "extra"
            },
            {
              "kind": "prompt",
              "with_system": true
            }
          ],
          "env": [
            {
              "name": "OPENCODE_CONFIG_DIR",
              "value": "boot",
              "operation": "set",
              "precedence": "provider-wins"
            }
          ]
        },
        "roots": {
          "ProjectRoot": "/fixture/project",
          "BootRoot": "<boot>",
          "ConfigRoot": "<boot>",
          "StateRoot": "/fixture/state",
          "ScratchRoot": "",
          "CWD": "/fixture/project"
        }
      },
      "env": {
        "OPENCODE_CONFIG_DIR": {
          "value": "<boot>",
          "source": "provider",
          "precedence": 20
        }
      },
      "cwd": "/fixture/project",
      "config_root": "<boot>"
    },
    "First": [
      "run",
      "--format",
      "json",
      "--agent",
      "fixture",
      "--dir",
      "/fixture/project",
      "--",
      "System: Fixture instructions.\n\nFixture turn."
    ],
    "Resumed": [
      "run",
      "--format",
      "json",
      "--agent",
      "fixture",
      "--dir",
      "/fixture/project",
      "--session",
      "fixture-session",
      "--",
      "System: Fixture instructions.\n\nFixture next turn."
    ]
  },
