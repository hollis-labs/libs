  "bindings": {
    "Bindings": {
      "argv": [
        "claude",
        "-p",
        "--input-format",
        "stream-json",
        "--output-format",
        "stream-json",
        "--verbose",
        "--mcp-config",
        "<boot>/.mcp.json",
        "--permission-mode",
        "acceptEdits",
        "--add-dir",
        "/fixture/project"
      ],
      "launch": {
        "convention": {
          "executable": "claude",
          "mode": "streaming-stdio",
          "cwd": "boot",
          "config_root": "boot",
          "argv": [
            {
              "kind": "resume",
              "value": "--resume"
            },
            {
              "kind": "literal",
              "value": "-p"
            },
            {
              "kind": "literal",
              "value": "--input-format"
            },
            {
              "kind": "literal",
              "value": "stream-json"
            },
            {
              "kind": "literal",
              "value": "--output-format"
            },
            {
              "kind": "literal",
              "value": "stream-json"
            },
            {
              "kind": "literal",
              "value": "--verbose"
            },
            {
              "kind": "file",
              "value": "--mcp-config",
              "root": "boot",
              "rel_path": ".mcp.json",
              "omit_empty": true
            },
            {
              "kind": "extra"
            },
            {
              "kind": "root",
              "value": "--add-dir",
              "root": "project",
              "omit_empty": true
            }
          ],
          "env": null
        },
        "roots": {
          "ProjectRoot": "/fixture/project",
          "BootRoot": "<boot>",
          "ConfigRoot": "<boot>",
          "StateRoot": "/fixture/state",
          "ScratchRoot": "",
          "CWD": "/fixture/project"
        },
        "extra_args": [
          "--permission-mode",
          "acceptEdits"
        ]
      },
      "cwd": "<boot>",
      "config_root": "<boot>"
    },
    "First": [
      "-p",
      "--input-format",
      "stream-json",
      "--output-format",
      "stream-json",
      "--verbose",
      "--mcp-config",
      "<boot>/.mcp.json",
      "--permission-mode",
      "acceptEdits",
      "--add-dir",
      "/fixture/project"
    ],
    "Resumed": [
      "--resume",
      "fixture-session",
      "-p",
      "--input-format",
      "stream-json",
      "--output-format",
      "stream-json",
      "--verbose",
      "--mcp-config",
      "<boot>/.mcp.json",
      "--permission-mode",
      "acceptEdits",
      "--add-dir",
      "/fixture/project"
    ]
  },
