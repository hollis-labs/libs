{
  "writer": "providerplant",
  "source": "substrate legacy provider projection",
  "bindings": {
    "Bindings": {
      "argv": [
        "agy",
        "--output-format",
        "stream-json",
        "--add-dir",
        "/fixture/project",
        "-p="
      ],
      "launch": {
        "convention": {
          "executable": "agy",
          "mode": "subprocess-per-turn",
          "cwd": "boot",
          "config_root": "boot",
          "argv": [
            {
              "kind": "literal",
              "value": "--output-format"
            },
            {
              "kind": "literal",
              "value": "stream-json"
            },
            {
              "kind": "extra"
            },
            {
              "kind": "root",
              "value": "--add-dir",
              "root": "project",
              "omit_empty": true
            },
            {
              "kind": "resume",
              "value": "--conversation"
            },
            {
              "kind": "prompt-inline",
              "value": "-p=",
              "with_system": true
            }
          ],
          "env": null
        },
        "roots": {
          "ProjectRoot": "/fixture/project",
          "BootRoot": "<boot>",
          "ConfigRoot": "<boot>",
          "StateRoot": "/fixture/state",
          "ScratchRoot": "",
          "CWD": "/fixture/project"
        }
      },
      "cwd": "<boot>",
      "config_root": "<boot>"
    },
    "First": [
      "--output-format",
      "stream-json",
      "--add-dir",
      "/fixture/project",
      "-p=System: Fixture instructions.\n\nFixture turn."
    ],
    "Resumed": [
      "--output-format",
      "stream-json",
      "--add-dir",
      "/fixture/project",
      "--conversation",
      "fixture-session",
      "-p=System: Fixture instructions.\n\nFixture next turn."
    ]
  },
