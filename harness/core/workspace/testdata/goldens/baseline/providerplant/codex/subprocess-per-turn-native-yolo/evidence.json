{
  "writer": "providerplant",
  "source": "substrate legacy provider projection",
  "bindings": {
    "Bindings": {
      "argv": [
        "codex",
        "exec",
        "-c",
        "sandbox_mode=\"danger-full-access\"",
        "-c",
        "approval_policy=\"never\"",
        "--json",
        "--skip-git-repo-check",
        "--cd",
        "/fixture/project",
        "--",
        "Fixture kickoff.\n"
      ],
      "launch": {
        "convention": {
          "executable": "codex",
          "mode": "subprocess-per-turn",
          "cwd": "boot",
          "config_root": "boot",
          "argv": [
            {
              "kind": "literal",
              "value": "exec"
            },
            {
              "kind": "extra"
            },
            {
              "kind": "literal",
              "value": "--json"
            },
            {
              "kind": "literal",
              "value": "--skip-git-repo-check"
            },
            {
              "kind": "root",
              "value": "--cd",
              "root": "project",
              "omit_empty": true
            },
            {
              "kind": "resume",
              "value": "resume"
            },
            {
              "kind": "prompt"
            }
          ],
          "env": [
            {
              "name": "CODEX_HOME",
              "value": "boot",
              "operation": "set",
              "precedence": "provider-wins"
            }
          ]
        },
        "roots": {
          "ProjectRoot": "/fixture/project",
          "BootRoot": "<boot>",
          "ConfigRoot": "<boot>",
          "StateRoot": "/fixture/state",
          "ScratchRoot": "",
          "CWD": "/fixture/project"
        },
        "extra_args": [
          "-c",
          "sandbox_mode=\"danger-full-access\"",
          "-c",
          "approval_policy=\"never\""
        ]
      },
      "env": {
        "CODEX_HOME": {
          "value": "<boot>",
          "source": "provider",
          "precedence": 20
        }
      },
      "cwd": "<boot>",
      "config_root": "<boot>"
    },
    "First": [
      "exec",
      "-c",
      "sandbox_mode=\"danger-full-access\"",
      "-c",
      "approval_policy=\"never\"",
      "--json",
      "--skip-git-repo-check",
      "--cd",
      "/fixture/project",
      "--",
      "Fixture turn."
    ],
    "Resumed": [
      "exec",
      "-c",
      "sandbox_mode=\"danger-full-access\"",
      "-c",
      "approval_policy=\"never\"",
      "--json",
      "--skip-git-repo-check",
      "--cd",
      "/fixture/project",
      "resume",
      "fixture-session",
      "--",
      "Fixture next turn."
    ]
  },
