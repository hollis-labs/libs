{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hollis-labs:runtimeevents:ingest-event/v1",
  "title": "One event as accepted by POST /events",
  "description": "The runtimeevents Event envelope plus what the hub requires of a publisher: a canonical id, an app, and closed vocabularies for the classification fields. Stricter than the generic envelope, which tolerates unknown vocabulary values. The payload is only required to be JSON; per-kind payload schemas are not validated at ingest.",
  "allOf": [
    { "$ref": "urn:hollis-labs:runtimeevents:event/v1" },
    {
      "required": ["app"],
      "properties": {
        "id": { "pattern": "^evt_[0-9a-f]{32}$" },
        "app": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
        "source": {
          "properties": {
            "channel": { "type": "string", "minLength": 1 },
            "confidence": { "enum": ["exact", "derived", "inferred"] }
          }
        },
        "class": {
          "properties": {
            "category": { "enum": ["activity", "state", "progress", "data", "message", "tool", "approval", "audit", "alert", "fleet", "step"] },
            "severity": { "enum": ["debug", "info", "notice", "warning", "error", "critical"] },
            "sensitivity": { "enum": ["public", "private", "secret"] },
            "visibility": { "enum": ["local", "environment", "mesh", "operator"] }
          }
        }
      }
    }
  ]
}
