{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hollis-labs:events:subagent_stop@1",
  "title": "subagent_stop@1",
  "description": "A subagent finished. The event's parent_id is the matching agent.subagent_spawn event id. Unknown fields are allowed.",
  "type": "object",
  "required": [
    "subagent_id",
    "outcome"
  ],
  "properties": {
    "subagent_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_type": {
      "type": "string"
    },
    "parent_tool_use_id": {
      "type": "string"
    },
    "outcome": {
      "enum": [
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    }
  }
}
