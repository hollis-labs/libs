{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hollis-labs:events:tool.call.started@1",
  "title": "tool.call.started@1",
  "description": "A tool call began. Never carries ok. Unknown fields are allowed.",
  "type": "object",
  "required": [
    "tool"
  ],
  "properties": {
    "tool": {
      "type": "string",
      "minLength": 1
    },
    "server": {
      "type": "string"
    },
    "args_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "args_schema_fp": {
      "type": "string"
    }
  },
  "not": {
    "required": [
      "ok"
    ]
  }
}
