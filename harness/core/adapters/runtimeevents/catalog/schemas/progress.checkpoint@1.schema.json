{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hollis-labs:events:progress.checkpoint@1",
  "title": "progress.checkpoint@1",
  "description": "Non-parking progress report at a detail level. Unknown fields are allowed.",
  "type": "object",
  "required": [
    "detail_level",
    "label"
  ],
  "properties": {
    "detail_level": {
      "type": "string",
      "description": "milestone, step or verbose"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "step": {
      "type": "integer",
      "minimum": 0
    },
    "total_steps": {
      "type": "integer",
      "minimum": 0
    },
    "summary": {
      "type": "string",
      "maxLength": 600
    },
    "data_ref": {
      "type": "string"
    }
  }
}
