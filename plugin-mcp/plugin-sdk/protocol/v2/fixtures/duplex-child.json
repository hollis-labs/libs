        {
          "op": "init"
        },
        {
          "op": "close_stdin"
        },
        {
          "op": "expect_exit",
          "effects": {
            "unload_attempts": 1
          }
        }
      ]
    },
    {
      "name": "host-sigterm-aborts-handler-and-unloads-once",
      "profile": "full",
      "level": "normative",
      "steps": [
        {
          "op": "init"
        },
        {
          "op": "send_host",
          "send": {
            "jsonrpc": "2.0",
            "id": 2,
            "method": "command/execute",
            "params": {
              "name": "wait-for-abort",
              "args": "",
              "session_id": ""
            }
          }
        },
        {
          "op": "barrier",
          "event": "handler_waiting"
        },
        {
          "op": "signal",
          "signal": "SIGTERM"
        },
        {
          "op": "expect_plugin_response",
          "expect": {
            "jsonrpc": "2.0",
            "id": 2,
            "result": {
              "action": "noop"
            }
          }
        },
        {
          "op": "expect_exit",
          "effects": {
            "unload_attempts": 1
          }
        }
      ]
    }
  ],
