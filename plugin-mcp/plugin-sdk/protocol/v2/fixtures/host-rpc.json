        "authority_valid": true
      },
      "expect": {
        "authority_revalidated_before_disclosure": true,
        "new_backend_commits": 0,
        "result": {
          "operation_key": "put-1",
          "revision": "r1"
        }
      }
    },
    {
      "name": "restart receipt still requires current authority",
