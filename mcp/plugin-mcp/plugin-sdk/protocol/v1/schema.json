{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "plugin-sdk stdio protocol v1 draft wire shapes",
  "description": "Reference wire shapes, not a runtime validator. Required payload fields describe complete producer output; the existing Go decoder also accepts omitted/null params and zero-values. See docs/protocol/v1/README.md.",
  "oneOf": [
    {
      "$ref": "#/$defs/RPCRequest"
    },
    {
      "$ref": "#/$defs/RPCResponse"
    }
  ],
  "$defs": {
    "RPCRequest": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "type": "string",
          "const": "2.0"
        },
        "id": {
          "type": "integer"
        },
        "method": {
          "type": "string"
        },
        "params": {}
      },
      "required": [
        "jsonrpc",
        "method"
      ],
      "additionalProperties": true
    },
    "RPCError": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer"
        },
        "message": {
          "type": "string"
        },
        "data": {}
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": true
    },
    "RPCResponse": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "type": "string",
          "const": "2.0"
        },
        "id": {
          "type": "integer"
        },
        "result": {},
        "error": {
          "$ref": "#/$defs/RPCError"
        }
      },
      "required": [
        "jsonrpc",
        "id"
      ],
      "additionalProperties": true,
      "oneOf": [
        {
          "required": [
            "result"
          ],
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "required": [
            "error"
          ],
          "not": {
            "required": [
              "result"
            ]
          }
        }
      ]
    },
    "HostInfo": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "protocol": {
          "type": "integer"
        }
      },
      "required": [
        "version",
        "protocol"
      ],
      "additionalProperties": true
    },
    "InitParams": {
      "type": "object",
      "properties": {
        "plugin_dir": {
          "type": "string"
        },
        "data_dir": {
          "type": "string"
        },
        "cache_dir": {
          "type": "string"
        },
        "config": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "log_level": {
          "type": "string"
        },
        "host_info": {
          "$ref": "#/$defs/HostInfo"
        },
        "granted": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "identity": {}
      },
      "required": [
        "plugin_dir",
        "data_dir",
        "cache_dir",
        "config",
        "log_level",
        "host_info"
      ],
      "additionalProperties": true
    },
    "InitResult": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "protocol": {
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "version",
        "description",
        "protocol"
      ],
      "additionalProperties": true
    },
    "SkippedRegistration": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "reason"
      ],
      "additionalProperties": true
    },
    "LoadResult": {
      "type": "object",
      "properties": {
        "skipped_registrations": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/SkippedRegistration"
          }
        }
      },
      "required": [],
      "additionalProperties": true
    },
    "EnvelopeOut": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "data": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {}
        },
        "session_id": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "data"
      ],
      "additionalProperties": true
    },
    "CommandExecParams": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "args": {
          "type": "string"
        },
        "identity": {}
      },
      "required": [
        "name",
        "session_id",
        "args"
      ],
      "additionalProperties": true
    },
    "CommandExecResult": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "envelopes": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/EnvelopeOut"
          }
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": true
    },
    "EventHandleParams": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "data": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {}
        },
        "session_id": {
          "type": "string"
        },
        "pre_hook": {
          "type": "boolean"
        },
        "identity": {}
      },
      "required": [
        "type",
        "source",
        "data",
        "pre_hook"
      ],
      "additionalProperties": true
    },
    "EventHandleResult": {
      "type": "object",
      "properties": {
        "cancel": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "envelopes": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/EnvelopeOut"
          }
        }
      },
      "required": [],
      "additionalProperties": true
    },
    "CRUDParams": {
      "type": "object",
      "properties": {
        "resource_type": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "data": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {}
        },
        "filters": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {}
        }
      },
      "required": [
        "resource_type"
      ],
      "additionalProperties": true
    },
    "CRUDResult": {
      "type": "object",
      "properties": {
        "data": {}
      },
      "required": [
        "data"
      ],
      "additionalProperties": true
    },
    "CRUDListResult": {
      "type": "object",
      "properties": {
        "items": {
          "type": [
            "array",
            "null"
          ],
          "items": {}
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": true
    },
    "HealthResult": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "ok"
      ],
      "additionalProperties": true
    },
    "MCPCallRequest": {
      "type": "object",
      "properties": {
        "tool_name": {
          "type": "string"
        },
        "arguments": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {}
        },
        "session_id": {
          "type": "string"
        },
        "identity": {}
      },
      "required": [
        "tool_name",
        "arguments"
      ],
      "additionalProperties": true
    },
    "MCPCallResult": {
      "type": "object",
      "properties": {
        "content": {},
        "is_error": {
          "type": "boolean"
        },
        "envelopes": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/EnvelopeOut"
          }
        }
      },
      "required": [
        "content"
      ],
      "additionalProperties": true
    },
    "HTTPRequest": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "raw_path": {
          "type": "string"
        },
        "raw_query": {
          "type": "string"
        },
        "query": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "headers": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "body": {
          "type": "string",
          "contentEncoding": "base64"
        },
        "session_id": {
          "type": "string"
        },
        "identity": {}
      },
      "required": [
        "method",
        "path"
      ],
      "additionalProperties": true
    },
    "HTTPResponse": {
      "type": "object",
      "properties": {
        "status": {
          "type": "integer"
        },
        "headers": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "body": {
          "type": "string",
          "contentEncoding": "base64"
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": true
    },
    "MigrateParams": {
      "type": "object",
      "properties": {
        "from_version": {
          "type": "string"
        },
        "to_version": {
          "type": "string"
        },
        "data_dir": {
          "type": "string"
        }
      },
      "required": [
        "from_version",
        "to_version",
        "data_dir"
      ],
      "additionalProperties": true
    },
    "MigrateResult": {
      "type": "object",
      "properties": {
        "notes": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "required": [],
      "additionalProperties": true
    },
    "CapabilityRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "optional": {
          "type": "boolean"
        },
        "metadata": {}
      },
      "required": [
        "name"
      ],
      "additionalProperties": true
    },
    "EmptyParams": {
      "type": "object",
      "properties": {},
      "additionalProperties": true
    },
    "OKResult": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        }
      },
      "required": [
        "ok"
      ],
      "additionalProperties": true
    }
  },
  "x-protocol-version": 1,
  "x-methods": {
    "plugin/init": {
      "params": "InitParams",
      "result": "InitResult",
      "handler": "required"
    },
    "plugin/load": {
      "params": "EmptyParams",
      "result": "LoadResult",
      "handler": "required"
    },
    "plugin/unload": {
      "params": "EmptyParams",
      "result": "OKResult",
      "handler": "required"
    },
    "plugin/health": {
      "params": "EmptyParams",
      "result": "HealthResult",
      "handler": "HealthChecker"
    },
    "command/execute": {
      "params": "CommandExecParams",
      "result": "CommandExecResult",
      "handler": "CommandHandler"
    },
    "event/handle": {
      "params": "EventHandleParams",
      "result": "EventHandleResult",
      "handler": "EventHandler"
    },
    "crud/create": {
      "params": "CRUDParams",
      "result": "CRUDResult",
      "handler": "CRUDHandler"
    },
    "crud/read": {
      "params": "CRUDParams",
      "result": "CRUDResult",
      "handler": "CRUDHandler"
    },
    "crud/update": {
      "params": "CRUDParams",
      "result": "CRUDResult",
      "handler": "CRUDHandler"
    },
    "crud/delete": {
      "params": "CRUDParams",
      "result": "OKResult",
      "handler": "CRUDHandler"
    },
    "crud/list": {
      "params": "CRUDParams",
      "result": "CRUDListResult",
      "handler": "CRUDHandler"
    },
    "mcp/call_tool": {
      "params": "MCPCallRequest",
      "result": "MCPCallResult",
      "handler": "MCPHandler"
    },
    "http/handle": {
      "params": "HTTPRequest",
      "result": "HTTPResponse",
      "handler": "HTTPHandler"
    },
    "plugin/migrate": {
      "params": "MigrateParams",
      "result": "MigrateResult",
      "handler": "Migrator"
    }
  }
}
